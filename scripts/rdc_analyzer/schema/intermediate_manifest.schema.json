{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://renderdoc.org/schemas/intermediate_manifest.schema.json",
  "title": "RDC Intermediate Extraction Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "schema_path",
    "event_id",
    "api",
    "sources",
    "buffers",
    "texture_decode"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "schema_path": {
      "type": "string"
    },
    "event_id": {
      "type": "integer"
    },
    "api": {
      "type": "string"
    },
    "sources": {
      "type": "object",
      "required": [
        "zip_xml",
        "zip_bin"
      ],
      "properties": {
        "zip_xml": {
          "type": "string"
        },
        "zip_bin": {
          "type": "string"
        }
      }
    },
    "buffers": {
      "type": "object",
      "required": [
        "index",
        "vertex"
      ],
      "properties": {
        "index": {
          "type": "object",
          "required": [
            "resource_id",
            "memory_id",
            "memory_offset",
            "zip_entry",
            "byte_offset",
            "byte_size"
          ],
          "properties": {
            "resource_id": {
              "type": "integer"
            },
            "memory_id": {
              "type": "integer"
            },
            "memory_offset": {
              "type": "integer"
            },
            "zip_entry": {
              "type": "string"
            },
            "byte_offset": {
              "type": "integer"
            },
            "byte_size": {
              "type": "integer"
            }
          }
        },
        "vertex": {
          "type": "object",
          "required": [
            "resource_id",
            "memory_id",
            "memory_offset",
            "zip_entry",
            "byte_offset",
            "byte_size",
            "layout_source"
          ],
          "properties": {
            "resource_id": {
              "type": "integer"
            },
            "memory_id": {
              "type": "integer"
            },
            "memory_offset": {
              "type": "integer"
            },
            "zip_entry": {
              "type": "string"
            },
            "byte_offset": {
              "type": "integer"
            },
            "byte_size": {
              "type": "integer"
            },
            "layout_source": {
              "type": "string"
            }
          }
        }
      }
    },
    "texture_decode": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "zip_entry",
          "decode_status"
        ],
        "properties": {
          "zip_entry": {
            "type": [
              "string",
              "null"
            ]
          },
          "decode_status": {
            "type": "string"
          }
        }
      }
    }
  }
}
