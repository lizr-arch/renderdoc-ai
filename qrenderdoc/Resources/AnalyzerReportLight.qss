#analyzerReportRoot {
  background: #F6F7FB;
}

#analyzerReportRoot QFrame[arCard="true"] {
  background: #FFFFFF;
  border: 1px solid #E5E7EB;
  border-radius: 8px;
}

#analyzerReportRoot QLabel[arH1="true"] {
  font-size: 18px;
  font-weight: 600;
  color: #111827;
}

#analyzerReportRoot QLabel[arH2="true"] {
  font-size: 14px;
  font-weight: 600;
  color: #111827;
}

#analyzerReportRoot QLabel[arCaption="true"] {
  font-size: 11px;
  color: #6B7280;
}

#analyzerReportRoot QTableView {
  background: #FFFFFF;
  border: 1px solid #E5E7EB;
  gridline-color: #E5E7EB;
  selection-background-color: #E0E7FF;
  selection-color: #111827;
}

#analyzerReportRoot QHeaderView::section {
  background: #F3F4F6;
  border: 1px solid #E5E7EB;
  padding: 4px 6px;
}

#analyzerReportRoot QPushButton {
  background: #FFFFFF;
  border: 1px solid #E5E7EB;
  border-radius: 6px;
  padding: 4px 10px;
}

#analyzerReportRoot QPushButton[arPrimary="true"] {
  background: #2563EB;
  border-color: #1D4ED8;
  color: #FFFFFF;
}

#analyzerReportRoot QLineEdit {
  border: 1px solid #E5E7EB;
  border-radius: 6px;
  padding: 4px 8px;
  background: #FFFFFF;
}

#analyzerReportRoot QProgressBar {
  background: #F3F4F6;
  border: 1px solid #E5E7EB;
  border-radius: 4px;
  height: 8px;
}

#analyzerReportRoot QProgressBar::chunk {
  background: #2563EB;
  border-radius: 3px;
}

#analyzerReportRoot QTabWidget::pane {
  border: 1px solid #E5E7EB;
  border-top: 0px;
}

#analyzerReportRoot QTabBar::tab {
  background: #F3F4F6;
  border: 1px solid #E5E7EB;
  border-bottom: none;
  padding: 6px 10px;
  margin-right: 2px;
  border-top-left-radius: 6px;
  border-top-right-radius: 6px;
}

#analyzerReportRoot QTabBar::tab:selected {
  background: #FFFFFF;
}
